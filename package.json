{
  "name": "cli-in-one",
  "version": "0.7.0",
  "description": "An Electron infinite-canvas workspace for watching multiple Windows cmd sessions in one view.",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build": "npm run build:renderer",
    "build:renderer": "vite build",
    "dev:renderer": "vite --host 127.0.0.1",
    "pack": "npm run build:renderer && electron-builder --dir --publish never",
    "dist": "npm run build:renderer && electron-builder --publish never",
    "dist:win": "npm run build:renderer && electron-builder --win nsis portable --publish never",
    "dist:mac": "npm run build:renderer && electron-builder --mac dmg zip --publish never",
    "smoke": "electron scripts/electron-smoke.js",
    "postinstall": "node scripts/check-native.js"
  },
  "keywords": [
    "electron",
    "cmd",
    "terminal",
    "infinite-canvas",
    "windows"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "node-pty": "^1.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.10"
  }
}
