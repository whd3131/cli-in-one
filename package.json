{
  "name": "cli-in-one",
  "version": "1.2.2",
  "description": "An Electron infinite-canvas workspace for watching multiple Windows cmd sessions in one view.",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build": "npm run build:renderer",
    "build:renderer": "vite build",
    "dev:renderer": "vite --host 127.0.0.1",
    "test:terminal-blocks": "node --test src/renderer/lib/terminalBlocks.test.mjs",
    "pack": "npm run build:renderer && electron-builder --dir --publish never",
    "dist": "npm run build:renderer && electron-builder --publish never",
    "dist:win": "npm run build:renderer && electron-builder --win nsis portable --publish never",
    "dist:mac": "npm run build:renderer && electron-builder --mac dmg zip --publish never",
    "smoke": "electron scripts/electron-smoke.js",
    "postinstall": "node scripts/check-native.js"
  },
  "keywords": [
    "electron",
    "cmd",
    "terminal",
    "infinite-canvas",
    "windows"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "json5": "^2.2.3",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "lucide-react": "^1.14.0",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^8.0.11"
  }
}
